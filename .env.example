# Resend: https://resend.com — create an API key, then:
#   RESEND_API_KEY=re_...
#   CONTACT_TO_EMAIL — inbox for submissions (matches millworkEmails.sales in lib/site-data.ts)
#   CONTACT_FROM_EMAIL — Resend sender; use onboarding@resend.dev for dev tests, verified domain address in production
# Optional: full URL to logo image (defaults to canonical site + /images/shioleno_full.svg)
# CONTACT_LOGO_URL=
# Contact form: spam handling is server-side (honeypot, minimum submit delay, per-IP rate limit). No extra env vars.
RESEND_API_KEY=
CONTACT_TO_EMAIL=sales@shiolenomillwork.com
CONTACT_FROM_EMAIL=
